{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Cloudflare Workers config for the ExeHacks site.
	//
	// This project is a Next.js STATIC EXPORT (`output: "export"` in
	// next.config.mjs). `next build` writes plain files to ./out and never
	// produces a server bundle. There is no .next/standalone directory.
	//
	// Without this file `wrangler deploy` auto-detects "Next.js", assumes a
	// server-rendered app, and migrates the project to the OpenNext Cloudflare
	// adapter. That adapter then fails reading
	// .next/standalone/.next/server/pages-manifest.json, because a static export
	// never creates it. Declaring the assets directory here keeps that
	// auto-configuration from running at all.
	//
	// Deliberately minimal. There is no "main", so this is an assets-only Worker
	// that just serves ./out. No code runs, which is why there is no
	// "observability" block either (there would be nothing to observe).
	//
	// Workers Builds (Settings → Build) on the EXCS account, not South West Collective:
	//   Build command:  npm run build
	//   Deploy command: npm run deploy
	//   Build variables: FORMSPREE_DEPLOY_KEY, NEXT_PUBLIC_FORMSPREE_PROJECT_ID
	//
	// Do not run `wrangler deploy` from a South West Collective login.
	// `wrangler whoami` must show the Exeter Computer Science Society account.
	// Pin that account with CLOUDFLARE_ACCOUNT_ID before deploying.
	"name": "hack-sw-website",

	// Kept a little behind today so it can never be ahead of the runtime the
	// deploy lands on. The build log showed workerd 1.20260811.1.
	"compatibility_date": "2026-08-01",

	"assets": {
		"directory": "./out",
		// Next emits /sponsor/index.html (trailingSlash: true). Force the slash so
		// /sponsor and /sponsor/ both resolve, matching the export.
		"html_handling": "force-trailing-slash",
		// Serve the exported out/404.html for unknown paths.
		"not_found_handling": "404-page"
	}
}
